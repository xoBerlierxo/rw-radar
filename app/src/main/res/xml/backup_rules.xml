<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and below. Nothing is backed up: a restored DataStore would claim FCM topics and an
     onboarding state that belong to the old install's anonymous uid (D12). -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
