rules_version = '2';
// RW Radar security rules (PLAN §5.2, CLAUDE.md §4).
// The poller uses the Admin SDK, which bypasses these rules, so "all other writes only from the
// poller's service account" holds by denying every client write except users/{uid}.
service cloud.firestore {
  match /databases/{db}/documents {

    match /companies/{id} {
      allow read: if true;
      allow write: if false;
      match /jobs/{jobId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /directory/{id} { allow read: if true;  allow write: if false; }
    match /news/{id}      { allow read: if true;  allow write: if false; }

    // users/{uid}: readable and writable only by that uid, with a constrained shape.
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      // Shape of a user doc. Every field is optional because the app also uses merge writes.
      // follows: registry ids (bounded; the registry has 100). families: only the 6 keys.
      // notifPrefs: only {jobs, signals}, both booleans. createdAt: a timestamp.
      function validUser(d) {
        return d.keys().hasOnly(['follows', 'families', 'notifPrefs', 'createdAt'])
          && (!('follows' in d) || (d.follows is list && d.follows.size() <= 150))
          && (!('families' in d) || (d.families is list
                && d.families.hasOnly(['design', 'data', 'product', 'gtm', 'eng', 'other'])))
          && (!('notifPrefs' in d) || (d.notifPrefs is map
                && d.notifPrefs.keys().hasOnly(['jobs', 'signals'])
                && (!('jobs' in d.notifPrefs) || d.notifPrefs.jobs is bool)
                && (!('signals' in d.notifPrefs) || d.notifPrefs.signals is bool)))
          && (!('createdAt' in d) || d.createdAt is timestamp);
      }
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && validUser(request.resource.data);
    }

    match /pollerRuns/{id} { allow read, write: if false; }
    match /meta/{doc}      { allow read, write: if false; }
  }
}
